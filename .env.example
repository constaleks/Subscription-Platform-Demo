# Host user/group IDs (output of `id -u` / `id -g`)
DOCKER_UID=1000
DOCKER_GID=1000

# Postgres (keep in sync with DB_* in backend/.env)
DB_DATABASE=uptime
DB_USERNAME=uptime_user
DB_PASSWORD=secret

# pgAdmin
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=Admin1234%

# Optional
MAILPIT_PORT=8025
STRIPE_SECRET=
